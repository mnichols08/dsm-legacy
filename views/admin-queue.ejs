<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Submission review | DSM</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body class="admin-page">
    <main class="admin-shell">
      <header class="admin-header">
        <div>
          <h1>Submission review</h1>
          <p>Signed in as <%= admin.email %></p>
        </div>
        <form action="/admin/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn" type="submit">SIGN OUT</button>
        </form>
      </header>

      <% if (notice) { %>
      <p class="admin-notice" role="status"><%= notice %></p>
      <% } %>

      <section aria-labelledby="wording-heading">
        <h2 id="wording-heading">Wording suggestions</h2>
        <% if (!wordingSuggestions.length) { %>
        <p>No wording suggestions are waiting for review.</p>
        <% } %> <% wordingSuggestions.forEach((submission) => { %>
        <article class="admin-panel">
          <h3><%= submission.section_key %> / <%= submission.field_key %></h3>
          <blockquote><%= submission.proposed_value %></blockquote>
          <p>
            Submitted by <%= submission.contributor_name || "Anonymous" %>
            on <%= new Date(submission.created_at).toLocaleString() %>
          </p>
          <form
            class="admin-review-form"
            action="/admin/submissions/wording/<%= submission.id %>/review"
            method="post"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label for="wording-note-<%= submission.id %>">Moderator note (optional)</label>
            <textarea
              id="wording-note-<%= submission.id %>"
              name="note"
              rows="2"
              maxlength="500"
            ></textarea>
            <div class="admin-review-actions">
              <button class="btn" type="submit" name="action" value="approved">APPROVE</button>
              <button class="btn" type="submit" name="action" value="rejected">REJECT</button>
            </div>
          </form>
        </article>
        <% }); %>
      </section>

      <section aria-labelledby="quotes-heading">
        <h2 id="quotes-heading">Community quotes</h2>
        <% if (!quotes.length) { %>
        <p>No quotes are waiting for review.</p>
        <% } %> <% quotes.forEach((submission) => { %>
        <article class="admin-panel">
          <blockquote><%= submission.quote %></blockquote>
          <p>
            Submitted by <%= submission.contributor_name || "Anonymous" %>
            on <%= new Date(submission.created_at).toLocaleString() %>
          </p>
          <form
            class="admin-review-form"
            action="/admin/submissions/quote/<%= submission.id %>/review"
            method="post"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label for="quote-note-<%= submission.id %>">Moderator note (optional)</label>
            <textarea
              id="quote-note-<%= submission.id %>"
              name="note"
              rows="2"
              maxlength="500"
            ></textarea>
            <div class="admin-review-actions">
              <button class="btn" type="submit" name="action" value="approved">APPROVE</button>
              <button class="btn" type="submit" name="action" value="rejected">REJECT</button>
            </div>
          </form>
        </article>
        <% }); %>
      </section>
    </main>
  </body>
</html>